<!-- Not Connected Alert Banner -->
<div id="not-connected-alert" class="connection-banner disconnected" style="<%= (typeof connectedAccounts !== 'undefined' && connectedAccounts.length > 0) ? 'display: none;' : 'display: flex;' %>; margin-bottom: 1.5rem;">
  <div class="banner-content">
    <div class="banner-icon" style="background: rgba(239, 68, 68, 0.1);">
      <svg width="26" height="26" fill="none" stroke="#ef4444" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>
    <div>
      <div class="banner-title" style="color: #f87171;">No WhatsApp Accounts Connected</div>
      <div class="banner-desc">You must pair at least one of your 5 WhatsApp accounts before you can transmit messages.</div>
    </div>
  </div>
  <div>
    <a href="/whatsapp/connect" class="btn btn-primary btn-sm">Connect Accounts (0/5) &rarr;</a>
  </div>
</div>

<!-- Main Message Composer Card -->
<div class="composer-card">
  <div class="card-header">
    <div>
      <h2 class="card-title">
        <svg width="22" height="22" fill="none" stroke="#10b981" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
        Send WhatsApp Message
      </h2>
      <p class="card-subtitle">Dispatch text, high-res images, videos or documents with Unicode and Bengali text support.</p>
    </div>
  </div>

  <form id="send-message-form" enctype="multipart/form-data">
    <input type="hidden" id="message-type-input" name="messageType" value="text">

    <!-- 1. Sender WhatsApp Account Selector (Up to 5 accounts) -->
    <div class="form-group">
      <label class="form-label" for="sender-account-select">Select Sender WhatsApp Account</label>
      <select id="sender-account-select" name="senderAccount" class="form-control" style="cursor: pointer; background: var(--bg-input);">
        <% accounts.forEach(acc => { %>
          <option value="<%= acc.sessionId %>" <%= acc.connected ? 'selected' : '' %> <%= acc.connected ? '' : 'disabled' %>>
            <%= acc.label %>: <%= acc.accountInfo ? (acc.accountInfo.formattedPhone + ' — ' + acc.accountInfo.name) : 'Not Linked' %> <%= acc.connected ? '● [Online]' : '○ [Offline]' %>
          </option>
        <% }); %>
      </select>
      <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
        Choose which of your 5 WhatsApp accounts will dispatch this message.
      </div>
    </div>

    <!-- 2. Message Type Selector Tabs -->
    <div class="form-group">
      <label class="form-label">Select Message Type</label>
      <div class="type-selector">
        <div class="type-tab active" data-type="text">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <span>Text Message</span>
        </div>
        <div class="type-tab" data-type="image">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>Image</span>
        </div>
        <div class="type-tab" data-type="video">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span>Video</span>
        </div>
        <div class="type-tab" data-type="document">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Document</span>
        </div>
      </div>
    </div>

    <!-- 2. Recipient Phone Number -->
    <div class="form-group">
      <label class="form-label" for="recipient-input">Recipient Phone Number (With Country Code)</label>
      <input
        type="tel"
        id="recipient-input"
        name="recipient"
        class="form-control"
        placeholder="e.g. 8801712345678 or +880 1712-345678"
        required
        autocomplete="off"
      >
      <div id="recipient-hint" style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
        Enter recipient phone with country code (e.g. 8801712345678 for Bangladesh, 919876543210 for India, +12025550199 for US)
      </div>
    </div>

    <!-- 3. Document Custom Filename (Only for document type) -->
    <div class="form-group" id="document-group" style="display: none;">
      <label class="form-label" for="custom-filename-input">Custom Display Document Filename (Optional)</label>
      <input
        type="text"
        id="custom-filename-input"
        name="customFileName"
        class="form-control"
        placeholder="e.g. Invoice-2026-Nov.pdf, Monthly_Report.xlsx"
      >
      <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
        If specified, recipient will see this file name instead of the raw uploaded name.
      </div>
    </div>

    <!-- 4. Media Upload Drag & Drop Area (For image, video, document) -->
    <div class="form-group" id="media-group" style="display: none;">
      <label class="form-label">Attach Media File</label>
      <input type="file" id="file-input" name="media" style="display: none;">
      
      <div class="dropzone" id="dropzone">
        <svg class="dropzone-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
        </svg>
        <div class="dropzone-text" id="dropzone-text">Click or drag file here to attach</div>
        <div class="dropzone-hint">Maximum upload size: 50 MB</div>
      </div>

      <!-- File Selected Preview Card -->
      <div class="file-preview-card" id="file-preview" style="display: none;">
        <div class="file-preview-left">
          <img id="file-thumb" class="file-preview-thumb" src="" alt="Thumbnail" style="display: none;">
          <div>
            <div class="file-preview-name" id="file-name-display">filename.png</div>
            <div class="file-preview-size" id="file-size-display">0 MB</div>
          </div>
        </div>
        <button type="button" class="btn btn-danger btn-sm" id="btn-remove-file">
          Remove
        </button>
      </div>
    </div>

    <!-- 5. Message Content / Caption Input -->
    <div class="form-group" id="text-group">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
        <label class="form-label" id="content-label" for="content-input" style="margin-bottom: 0;">Message Content</label>
        <span class="char-counter" id="char-counter">0 characters</span>
      </div>

      <textarea
        id="content-input"
        name="content"
        class="form-control"
        rows="4"
        placeholder="Type your message here... Unicode, multiline breaks, and emojis are fully supported! 🚀✨"
      ></textarea>

      <!-- Quick Template Snippets -->
      <div class="quick-snippets">
        <span class="snippet-label">Quick Templates:</span>
        <button type="button" class="snippet-btn" data-text="Hello! How are you?">Hello! How are you?</button>
        <button type="button" class="snippet-btn" data-text="Your order has been confirmed. Thank you!">Order Confirmation</button>
        <button type="button" class="snippet-btn" data-text="Special Offer: Book today for 20% discount! 🚀">20% Discount Offer</button>
        <button type="button" class="snippet-btn" data-text="Best regards and thank you!">Best Regards</button>
      </div>
    </div>

    <!-- 6. Submit Button & State -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 2rem; border-top: 1px solid var(--border-subtle); padding-top: 1.5rem; flex-wrap: wrap; gap: 1rem;">
      <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem;">
        <svg width="16" height="16" fill="none" stroke="#10b981" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span>End-to-end encrypted dispatch • Duplicate submission protection active</span>
      </div>

      <button
        type="submit"
        class="btn btn-primary btn-lg"
        id="btn-submit"
        <%= (typeof statusInfo !== 'undefined' && statusInfo.status === 'connected') ? '' : 'disabled' %>
      >
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
        <span>Send WhatsApp Message</span>
      </button>
    </div>
  </form>
</div>

<!-- Messenger Client Script -->
<script src="/js/messenger.js" defer></script>
