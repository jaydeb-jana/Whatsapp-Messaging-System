<!-- Connection Banner -->
<div class="connection-banner <%= (connectedCount > 0) ? 'connected' : 'disconnected' %>">
  <div class="banner-content">
    <div class="banner-icon">
      <svg width="28" height="28" fill="none" stroke="<%= (connectedCount > 0) ? '#10b981' : '#ef4444' %>" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
    </div>
    <div>
      <div class="banner-title">
        <% if (connectedCount > 0) { %>
          <span><%= connectedCount %> of <%= maxAccounts %> WhatsApp Accounts Active</span>
        <% } else { %>
          <span>No WhatsApp Accounts Connected (0 of <%= maxAccounts %> Linked)</span>
        <% } %>
      </div>
      <div class="banner-desc">
        <% if (connectedCount > 0) { %>
          Status: <strong style="color: var(--text-accent);" id="banner-status-text">ONLINE</strong> • Multi-device channels are active. You can link up to 5 accounts concurrently.
        <% } else { %>
          Status: <strong style="color: #f87171;" id="banner-status-text">OFFLINE</strong> • Scan a QR code to pair your first account and start sending messages.
        <% } %>
      </div>
    </div>
  </div>
  <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
    <a href="/whatsapp/connect" class="btn btn-secondary">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Manage 5 Slots
    </a>
    <% if (connectedCount > 0) { %>
      <a href="/messages/send" class="btn btn-primary">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
        Compose Message
      </a>
    <% } else { %>
      <a href="/whatsapp/connect" class="btn btn-primary">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
        </svg>
        Link Account
      </a>
    <% } %>
  </div>
</div>

<!-- Metrics & Stats Grid -->
<div class="stats-grid">
  <!-- Total Dispatches -->
  <div class="stat-card">
    <div class="stat-icon blue">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
      </svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Total Messages</span>
      <span class="stat-value" id="stat-total"><%= stats.total %></span>
      <span class="stat-sub">Lifetime transmissions</span>
    </div>
  </div>

  <!-- Successful Messages -->
  <div class="stat-card">
    <div class="stat-icon green">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Successful Sent</span>
      <span class="stat-value" id="stat-sent" style="color: var(--text-accent);"><%= stats.sent %></span>
      <span class="stat-sub">Delivered via WhatsApp Web</span>
    </div>
  </div>

  <!-- Failed Messages -->
  <div class="stat-card">
    <div class="stat-icon red">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Failed Messages</span>
      <span class="stat-value" id="stat-failed" style="color: #f87171;"><%= stats.failed %></span>
      <span class="stat-sub">Network or validation errors</span>
    </div>
  </div>

  <!-- Success Rate / Today -->
  <div class="stat-card">
    <div class="stat-icon purple">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
      </svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Success Rate</span>
      <span class="stat-value" id="stat-success-rate"><%= stats.successRate %>%</span>
      <span class="stat-sub"><strong id="stat-today"><%= stats.sentToday %></strong> sent today</span>
    </div>
  </div>
</div>

<!-- Main Two-Column Layout -->
<div class="dashboard-grid">
  <!-- Left: Recent Activity Table -->
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Recent Messaging Activity
        </h2>
        <p class="card-subtitle">Real-time log of the latest messages sent through the platform</p>
      </div>
      <a href="/messages/history" class="btn btn-secondary btn-sm">View Full History &rarr;</a>
    </div>

    <div class="table-responsive">
      <table class="custom-table">
        <thead>
          <tr>
            <th>Recipient</th>
            <th>Type</th>
            <th>Content / Summary</th>
            <th>Status</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody id="recent-messages-tbody">
          <% if (stats.recentMessages && stats.recentMessages.length > 0) { %>
            <% stats.recentMessages.forEach(msg => { %>
              <tr>
                <td><span class="table-recipient"><%= msg.recipient %></span></td>
                <td>
                  <% if (msg.messageType === 'text') { %>
                    <span class="badge badge-info">💬 Text</span>
                  <% } else if (msg.messageType === 'image') { %>
                    <span class="badge badge-info">🖼️ Image</span>
                  <% } else if (msg.messageType === 'video') { %>
                    <span class="badge badge-info">🎥 Video</span>
                  <% } else { %>
                    <span class="badge badge-info">📄 Doc</span>
                  <% } %>
                </td>
                <td>
                  <span class="table-content-preview">
                    <%= msg.content || msg.fileName || 'Media dispatch' %>
                  </span>
                </td>
                <td>
                  <% if (msg.status === 'sent') { %>
                    <span class="badge badge-success">SENT</span>
                  <% } else if (msg.status === 'failed') { %>
                    <span class="badge badge-danger" title="<%= msg.errorMessage %>">FAILED</span>
                  <% } else { %>
                    <span class="badge badge-warning"><%= msg.status.toUpperCase() %></span>
                  <% } %>
                </td>
                <td style="font-size: 0.75rem; color: var(--text-muted);">
                  <%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr id="empty-recent-state">
              <td colspan="5" style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
                <div style="font-size: 1.8rem; margin-bottom: 0.5rem;">📬</div>
                No messaging activity recorded yet.<br>
                <a href="/messages/send" style="color: var(--text-accent); text-decoration: none; font-weight: 600;">Send your first WhatsApp message &rarr;</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right: Quick Actions & System Event Stream -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Quick Compose Card -->
    <div class="card" style="background: linear-gradient(180deg, #162032 0%, var(--bg-card) 100%);">
      <h3 class="card-title" style="margin-bottom: 0.75rem;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Quick Message
      </h3>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
        Dispatch text messages, images, videos or documents with Unicode and Bengali language support.
      </p>
      <a href="/messages/send" class="btn btn-primary" style="width: 100%;">
        Open Message Composer &rarr;
      </a>
    </div>

    <!-- System Activity Log -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          System Event Log
        </h3>
      </div>
      <div class="activity-list">
        <% if (recentActivities && recentActivities.length > 0) { %>
          <% recentActivities.forEach(item => { %>
            <div class="activity-item">
              <div class="activity-badge <%= item.level === 'success' ? 'badge-success' : item.level === 'error' ? 'badge-danger' : 'badge-info' %>">
                <% if (item.type === 'connection') { %>
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <% } else { %>
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                <% } %>
              </div>
              <div class="activity-info">
                <span class="activity-title"><%= item.event %></span>
                <span class="activity-desc"><%= item.details %></span>
                <span class="activity-time"><%= new Date(item.createdAt).toLocaleTimeString() %></span>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div style="font-size: 0.82rem; color: var(--text-muted); text-align: center; padding: 1.5rem 0;">
            No recent system events logged.
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Dashboard Specific JS -->
<script src="/js/dashboard.js" defer></script>
