<!-- Multi-Account Slot Switcher Header -->
<div class="card" style="margin-bottom: 2rem; background: linear-gradient(180deg, #162032 0%, var(--bg-card) 100%);">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h2 style="font-size: 1.25rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.6rem;">
        <svg width="22" height="22" fill="none" stroke="#10b981" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <span>WhatsApp Multi-Account Manager</span>
      </h2>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
        You can connect and manage up to <strong>5 WhatsApp accounts</strong> concurrently. Select a slot below to link or manage.
      </p>
    </div>
    <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-main); padding: 0.45rem 0.95rem; border-radius: var(--radius-full); border: 1px solid var(--border-color); font-size: 0.82rem;">
      <span style="color: var(--text-muted);">Active Slots:</span>
      <strong id="connected-count-pill" style="color: var(--text-accent);">
        <%= accounts.filter(a => a.connected).length %> / 5 Connected
      </strong>
    </div>
  </div>

  <!-- 5 Account Slot Buttons Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.85rem;" id="slots-grid">
    <% accounts.forEach(acc => { %>
      <div 
        class="slot-card <%= (selectedSessionId === acc.sessionId) ? 'active' : '' %>"
        data-session-id="<%= acc.sessionId %>"
        data-slot="<%= acc.slot %>"
        onclick="switchAccountSlot('<%= acc.sessionId %>', <%= acc.slot %>)"
        style="
          background: <%= (selectedSessionId === acc.sessionId) ? 'rgba(16, 185, 129, 0.12)' : 'var(--bg-input)' %>;
          border: 1.5px solid <%= (selectedSessionId === acc.sessionId) ? 'var(--primary)' : 'var(--border-color)' %>;
          border-radius: var(--radius-md);
          padding: 1rem;
          cursor: pointer;
          transition: all 0.2s ease;
          position: relative;
        "
      >
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
          <span style="font-size: 0.88rem; font-weight: 700; color: #fff;">Slot <%= acc.slot %></span>
          <span class="status-dot <%= acc.status %>" id="dot-<%= acc.sessionId %>"></span>
        </div>
        <div style="font-size: 0.78rem; color: <%= acc.connected ? 'var(--text-accent)' : 'var(--text-muted)' %>; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" id="phone-<%= acc.sessionId %>">
          <%= acc.accountInfo ? (acc.accountInfo.formattedPhone || acc.accountInfo.name) : 'Ready to Link' %>
        </div>
        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: capitalize; margin-top: 0.2rem;" id="status-<%= acc.sessionId %>">
          <%= acc.status %>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<div class="connect-container">
  <!-- Left Column: Dynamic QR Code Box or Connected State Card for Selected Slot -->
  <div>
    <!-- QR Code Card (Visible when selected slot is disconnected or connecting) -->
    <div class="qr-box-wrapper" id="qr-card" style="<%= statusInfo.status === 'connected' ? 'display: none;' : 'display: flex;' %>">
      <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
        <span class="badge badge-<%= statusInfo.status === 'connected' ? 'success' : statusInfo.status === 'disconnected' ? 'danger' : 'warning' %>" id="connection-state-pill">
          <%= statusInfo.status.toUpperCase() %>
        </span>
        <span class="qr-timer-pill">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span id="qr-countdown"><%= statusInfo.qrExpirySeconds || 45 %>s</span>
        </span>
      </div>

      <h2 style="font-size: 1.35rem; font-weight: 700; margin-top: 1rem; color: #fff;">
        Scan QR Code for <span id="active-slot-name" style="color: var(--text-accent);">Account <%= selectedSlot %></span>
      </h2>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
        Open WhatsApp on your mobile phone and scan the code to link this account.
      </p>

      <!-- QR Display Frame with Laser Scan Line -->
      <div class="qr-frame">
        <div class="qr-scanner-line"></div>
        <img id="qr-image" src="<%= statusInfo.qrDataUrl || '' %>" alt="WhatsApp QR Code" style="<%= statusInfo.qrDataUrl ? 'display:block;' : 'display:none;' %>">
        <div class="qr-loading-placeholder" id="qr-placeholder" style="<%= statusInfo.qrDataUrl ? 'display:none;' : 'display:flex;' %>">
          <div class="qr-spinner"></div>
          <span>Waiting for QR Code...</span>
          <span style="font-size: 0.75rem; color: #64748b; font-weight: 400;">Click "Initialize Connection" below to generate QR</span>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem; width: 100%; justify-content: center; margin-top: 0.5rem; flex-wrap: wrap;">
        <button class="btn btn-primary" id="btn-connect">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Initialize Connection
        </button>
        <button class="btn btn-secondary" id="btn-refresh-qr">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Refresh QR
        </button>
      </div>

      <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 1.25rem;">
        QR code auto-refreshes periodically to maintain secure authentication tokens.
      </p>
    </div>

    <!-- Connected Account Card (Visible when selected slot is connected) -->
    <div class="connected-account-card" id="connected-card" style="<%= statusInfo.status === 'connected' ? 'display: flex;' : 'display: none;' %>">
      <div class="account-large-avatar">
        <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>

      <span class="badge badge-success" style="margin-bottom: 0.75rem;">CONNECTED & READY</span>

      <h2 style="font-size: 1.4rem; font-weight: 700; color: #fff;" id="connected-account-name">
        <%= statusInfo.accountInfo ? (statusInfo.accountInfo.name || 'WhatsApp Account #' + selectedSlot) : 'WhatsApp Account #' + selectedSlot %>
      </h2>
      <p style="font-size: 1rem; color: var(--text-accent); font-weight: 600; margin-top: 0.2rem;" id="connected-account-phone">
        <%= statusInfo.accountInfo ? (statusInfo.accountInfo.formattedPhone || '') : '' %>
      </p>

      <div style="background: var(--bg-main); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem 1.5rem; width: 100%; margin: 1.5rem 0; text-align: left; font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--text-muted);">Slot ID:</span>
          <strong id="connected-slot-label">Slot #<%= selectedSlot %> (<%= selectedSessionId %>)</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--text-muted);">Protocol Engine:</span>
          <strong>Baileys Multi-Device v7</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--text-muted);">Connected Since:</span>
          <span id="connected-account-time">
            <%= (statusInfo.accountInfo && statusInfo.accountInfo.connectedAt) ? new Date(statusInfo.accountInfo.connectedAt).toLocaleTimeString() : 'Active' %>
          </span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--text-muted);">Session Persistence:</span>
          <span style="color: var(--text-accent); font-weight: 600;">Active (Auto-Restores on Restart)</span>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; width: 100%; justify-content: center; flex-wrap: wrap;">
        <a href="/messages/send" class="btn btn-primary">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
          Go to Message Composer
        </a>
        <button class="btn btn-danger" id="btn-disconnect">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Disconnect This Account
        </button>
      </div>
    </div>
  </div>

  <!-- Right Column: Step-by-Step Instructions & Multi-Account Guidelines -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Step Instructions -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          How to Link WhatsApp Accounts
        </h3>
      </div>
      <ol class="instructions-list">
        <li>
          <div>
            Select the desired <strong>Account Slot (1 to 5)</strong> from the top bar.
          </div>
        </li>
        <li>
          <div>
            Click <strong>Initialize Connection</strong> to generate the pairing QR code for that slot.
          </div>
        </li>
        <li>
          <div>
            On your phone, open WhatsApp &gt; <strong>Linked Devices</strong> &gt; <strong>Link a Device</strong>.
          </div>
        </li>
        <li>
          <div>
            Scan the QR code. You can repeat this process for up to <strong>5 different WhatsApp numbers</strong>.
          </div>
        </li>
      </ol>
    </div>

    <!-- Multi-Account Architecture Information -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <svg width="20" height="20" fill="none" stroke="#10b981" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Multi-Account Capabilities
        </h3>
      </div>
      <div style="font-size: 0.85rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.75rem; line-height: 1.6;">
        <p>
          <strong style="color: #fff;">Independent Sockets:</strong> Each of your 5 accounts runs in its own isolated multi-device sandbox with its own authentication credentials.
        </p>
        <p>
          <strong style="color: #fff;">Sender Account Selection:</strong> When composing a message, choose which linked account to send from with a single click.
        </p>
        <p>
          <strong style="color: #fff;">Persistent Multi-Session Restoration:</strong> All authenticated slots auto-restore on server reboot without re-scanning.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Connect Page Client Script -->
<script>
  window.currentSlot = <%= selectedSlot %>;
  window.currentSessionId = '<%= selectedSessionId %>';
</script>
<script src="/js/connect.js" defer></script>
