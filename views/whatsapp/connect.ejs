<!-- Multi-Account Manager Header & Slot Grid -->
<div class="card" style="margin-bottom: 2rem; background: linear-gradient(180deg, #162032 0%, var(--bg-card) 100%);">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h2 style="font-size: 1.25rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.6rem;">
        <svg width="22" height="22" fill="none" stroke="#10b981" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <span>WhatsApp Multi-Account Manager</span>
      </h2>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
        Connect and operate up to <strong>5 WhatsApp accounts</strong> concurrently. Click the <strong>+</strong> button to add a new account.
      </p>
    </div>
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <div style="background: var(--bg-main); padding: 0.45rem 0.95rem; border-radius: var(--radius-full); border: 1px solid var(--border-color); font-size: 0.82rem;">
        <span style="color: var(--text-muted);">Active Channels:</span>
        <strong id="connected-count-pill" style="color: var(--text-accent);">
          <%= accounts.filter(a => a.connected).length %> / 5 Online
        </strong>
      </div>
      <button class="btn btn-primary btn-sm" id="btn-quick-add" onclick="openPairingModal()" <%= accounts.length >= maxAccounts ? 'disabled style="opacity:0.5;"' : '' %>>
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
        </svg>
        <span>Add Account</span>
      </button>
    </div>
  </div>

  <!-- Dynamic Account Slots Grid + Plus (+) Add Card -->
  <div class="slots-grid-container" id="slots-grid">
    <% accounts.forEach(acc => { %>
      <div 
        class="slot-card <%= (selectedSessionId === acc.sessionId) ? 'active' : '' %> <%= acc.status === 'disconnected' ? 'disconnected' : '' %>"
        data-session-id="<%= acc.sessionId %>"
        data-slot="<%= acc.slot %>"
        id="card-<%= acc.sessionId %>"
        onclick="switchAccountSlot('<%= acc.sessionId %>', <%= acc.slot %>)"
      >
        <!-- Remove ✕ button on top right of EVERY card -->
        <button 
          type="button" 
          class="slot-remove-btn" 
          title="Remove this account"
          onclick="event.stopPropagation(); removeAccountSlot('<%= acc.sessionId %>', <%= acc.slot %>)"
        >✕</button>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.4rem;">
          <span style="font-size: 0.88rem; font-weight: 700; color: #fff;">Slot <%= acc.slot %></span>
          <span class="status-dot <%= acc.status %>" id="dot-<%= acc.sessionId %>"></span>
        </div>

        <div style="font-size: 0.78rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: <%= acc.connected ? 'var(--text-accent)' : acc.status === 'disconnected' ? '#f87171' : 'var(--text-muted)' %>;" id="phone-<%= acc.sessionId %>">
          <% if (acc.connected) { %>
            <%= acc.accountInfo ? (acc.accountInfo.formattedPhone || acc.accountInfo.name) : 'Connected' %>
          <% } else if (acc.status === 'disconnected') { %>
            Disconnected
          <% } else { %>
            Connecting...
          <% } %>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 0.4rem; font-size: 0.72rem; flex-wrap: wrap; gap: 0.35rem;">
          <span style="color: var(--text-muted); text-transform: capitalize;" id="status-<%= acc.sessionId %>">
            <%= acc.status %>
          </span>

          <div style="display: flex; align-items: center; gap: 0.35rem;">
            <% if (acc.status === 'disconnected') { %>
              <button 
                type="button" 
                class="slot-reconnect-btn" 
                id="reconn-btn-<%= acc.sessionId %>"
                onclick="event.stopPropagation(); openReconnectModal('<%= acc.sessionId %>', <%= acc.slot %>)"
              >
                ⚡ Reconnect
              </button>
            <% } %>

            <button 
              type="button" 
              class="slot-remove-btn-inline" 
              title="Remove this account"
              onclick="event.stopPropagation(); removeAccountSlot('<%= acc.sessionId %>', <%= acc.slot %>)"
            >
              <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Remove
            </button>
          </div>
        </div>
      </div>
    <% }); %>

    <!-- Plus (+) Add Account Card -->
    <div 
      class="add-slot-card <%= accounts.length >= maxAccounts ? 'disabled' : '' %>" 
      id="card-add-button"
      onclick="openPairingModal()"
    >
      <div class="add-slot-icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
        </svg>
      </div>
      <div style="font-size: 0.88rem; font-weight: 700; color: #fff;" id="add-card-title">
        <%= accounts.length >= maxAccounts ? 'Max Slots Reached' : '+ Add Account' %>
      </div>
      <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem;" id="add-card-subtitle">
        <%= accounts.length >= maxAccounts ? '5 of 5 accounts in use' : 'Link another number (' + accounts.length + '/5)' %>
      </div>
    </div>
  </div>
</div>

<div class="connect-container">
  <!-- Left Column: Selected Account Workspace Card -->
  <div>
    <% if (accounts.length === 0) { %>
      <!-- Zero State (When no accounts exist) -->
      <div class="card" style="padding: 3rem 1.5rem; text-align: center;">
        <div style="font-size: 2.75rem; margin-bottom: 0.85rem;">📱</div>
        <h3 style="font-size: 1.35rem; font-weight: 700; color: #fff;">No WhatsApp Accounts Connected</h3>
        <p style="font-size: 0.88rem; color: var(--text-secondary); max-width: 440px; margin: 0.5rem auto 1.5rem; line-height: 1.5;">
          You currently have no connected accounts. Click the button below to link your WhatsApp account by scanning a live <strong>QR Code</strong> or with your <strong>Mobile Phone Number</strong>.
        </p>
        <button class="btn btn-primary" onclick="openPairingModal()">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
          + Link WhatsApp Account
        </button>
      </div>
    <% } else { %>
      <!-- STATE 1: Disconnected State Card (Shows when selected account is offline) -->
      <div 
        class="disconnected-account-card" 
        id="disconnected-card" 
        style="<%= statusInfo.status === 'disconnected' ? 'display: flex;' : 'display: none;' %>"
      >
        <div class="disconnected-large-avatar">
          <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
          </svg>
        </div>

        <span class="badge badge-danger" style="margin-bottom: 0.85rem;" id="disconn-badge">ACCOUNT DISCONNECTED</span>

        <h2 style="font-size: 1.45rem; font-weight: 700; color: #fff;">
          <span id="disconn-slot-title">Account <%= selectedSlot %></span> is Disconnected
        </h2>
        <p style="font-size: 0.88rem; color: var(--text-secondary); max-width: 420px; margin: 0.4rem auto 1.5rem; line-height: 1.5;">
          This WhatsApp channel is offline or logged out. Click <strong>⚡ Reconnect Account</strong> to scan a new QR code, or click <strong>Remove Account</strong> to delete it.
        </p>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
          <button class="btn btn-primary" id="btn-main-reconnect" onclick="openReconnectModal()">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            ⚡ Reconnect Account (Scan QR)
          </button>

          <!-- Remove Account Button ALWAYS visible on Disconnected Card -->
          <button 
            class="btn btn-danger" 
            id="btn-remove-active" 
            style="display: inline-flex;"
            onclick="removeActiveAccount()"
          >
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Remove Account
          </button>
        </div>
      </div>

      <!-- STATE 2: Connected Account Card (Shows when selected account is online) -->
      <div 
        class="connected-account-card" 
        id="connected-card" 
        style="<%= statusInfo.status === 'connected' ? 'display: flex;' : 'display: none;' %>"
      >
        <div class="account-large-avatar">
          <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>

        <span class="badge badge-success" style="margin-bottom: 0.75rem;">CONNECTED & ONLINE</span>

        <h2 style="font-size: 1.4rem; font-weight: 700; color: #fff;" id="connected-account-name">
          <%= statusInfo.accountInfo ? (statusInfo.accountInfo.name || 'WhatsApp Account #' + selectedSlot) : 'WhatsApp Account #' + selectedSlot %>
        </h2>
        <p style="font-size: 1rem; color: var(--text-accent); font-weight: 600; margin-top: 0.2rem;" id="connected-account-phone">
          <%= statusInfo.accountInfo ? (statusInfo.accountInfo.formattedPhone || '') : '' %>
        </p>

        <div style="background: var(--bg-main); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem 1.5rem; width: 100%; margin: 1.5rem 0; text-align: left; font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Slot ID:</span>
            <strong id="connected-slot-label">Slot #<%= selectedSlot %> (<%= selectedSessionId %>)</strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Protocol Engine:</span>
            <strong>Baileys Multi-Device v7</strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Connected Since:</span>
            <span id="connected-account-time">
              <%= (statusInfo.accountInfo && statusInfo.accountInfo.connectedAt) ? new Date(statusInfo.accountInfo.connectedAt).toLocaleTimeString() : 'Active' %>
            </span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Session Persistence:</span>
            <span style="color: var(--text-accent); font-weight: 600;">Active (Auto-Restores on Restart)</span>
          </div>
        </div>

        <div style="display: flex; gap: 0.75rem; width: 100%; justify-content: center; flex-wrap: wrap;">
          <button class="btn btn-secondary" id="btn-disconnect">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Disconnect
          </button>
          <button class="btn btn-danger" onclick="removeActiveAccount()">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Remove Account
          </button>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Right Column: Step-by-Step Instructions & Multi-Account Guidelines -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Step Instructions -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          How to Link WhatsApp Accounts
        </h3>
      </div>
      <ol class="instructions-list">
        <li>
          <div>
            Click <strong>+ Add Account</strong> to pair a new WhatsApp channel (up to 5 accounts max).
          </div>
        </li>
        <li>
          <div>
            Choose to pair via <strong>Scan QR Code</strong> or <strong>Mobile Phone Number</strong> (8-digit pairing code).
          </div>
        </li>
        <li>
          <div>
            Only once pairing is <strong>100% successful</strong> will the account be saved to your dashboard!
          </div>
        </li>
        <li>
          <div>
            If any account is disconnected, you can click <strong>⚡ Reconnect</strong> to restore it, or <strong>Remove Account</strong> to delete it!
          </div>
        </li>
      </ol>
    </div>

    <!-- Multi-Account Architecture Information -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <svg width="20" height="20" fill="none" stroke="#10b981" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Multi-Account Capabilities
        </h3>
      </div>
      <div style="font-size: 0.85rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.75rem; line-height: 1.6;">
        <p>
          <strong style="color: #fff;">Isolated Sockets:</strong> Each WhatsApp account operates in its own sandboxed multi-device session.
        </p>
        <p>
          <strong style="color: #fff;">Safe Pairing:</strong> Temporary pairing attempts that are closed or cancelled are never saved as ghost slots.
        </p>
        <p>
          <strong style="color: #fff;">Full Account Control:</strong> Easily remove any linked account with one click to free up your slots.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================================================
     Luxury Glassmorphic Pairing Modal (Opens on + Add Account or ⚡ Reconnect)
     ========================================================================== -->
<div class="qr-modal-overlay" id="qr-modal-overlay" style="display: none;">
  <div class="qr-modal-card">
    <button type="button" class="qr-modal-close" onclick="closePairingModal()">&times;</button>

    <div class="qr-modal-header">
      <div class="qr-modal-icon">
        <svg width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
        </svg>
      </div>
      <div>
        <h3 class="qr-modal-title" id="modal-title">Link WhatsApp Account</h3>
        <p class="qr-modal-subtitle" id="modal-subtitle">Choose QR code or Phone Number to pair your device (Channel <span id="modal-slot-num">1</span> of 5)</p>
      </div>
    </div>

    <!-- Pairing Method Selector Tabs -->
    <div class="pairing-method-tabs">
      <button type="button" class="method-tab-btn active" id="btn-tab-qr" onclick="switchPairingMethod('qr')">
        <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
        </svg>
        <span>Scan QR Code</span>
      </button>
      <button type="button" class="method-tab-btn" id="btn-tab-phone" onclick="switchPairingMethod('phone')">
        <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
        <span>Pair with Phone Number</span>
      </button>
    </div>

    <!-- METHOD 1: QR View State -->
    <div id="modal-qr-view">
      <!-- Quick Steps Bar for QR -->
      <div class="modal-steps-bar">
        <div class="modal-step"><span class="step-num">1</span> Open WhatsApp</div>
        <div class="modal-step-arrow">&rarr;</div>
        <div class="modal-step"><span class="step-num">2</span> Linked Devices</div>
        <div class="modal-step-arrow">&rarr;</div>
        <div class="modal-step"><span class="step-num">3</span> Scan QR</div>
      </div>

      <div class="qr-frame modal-qr-frame">
        <div class="qr-scanner-line"></div>
        <img id="modal-qr-img" src="" alt="WhatsApp QR Code" style="display: none;">
        <div class="qr-loading-placeholder" id="modal-qr-placeholder">
          <div class="qr-spinner"></div>
          <span>Generating QR Code...</span>
          <span style="font-size: 0.74rem; color: #64748b; font-weight: 400;">Handshaking with WhatsApp servers</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1.25rem; padding: 0 0.5rem;">
        <span class="qr-timer-pill">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span id="modal-qr-timer">45s</span>
        </span>
        <button type="button" class="btn btn-secondary btn-sm" id="btn-modal-refresh" onclick="refreshModalQr()">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Refresh QR
        </button>
      </div>
    </div>

    <!-- METHOD 2: Phone Number Pairing Code View State -->
    <div id="modal-phone-view" style="display: none;">
      <!-- Steps Bar for Phone -->
      <div class="modal-steps-bar">
        <div class="modal-step"><span class="step-num">1</span> Linked Devices</div>
        <div class="modal-step-arrow">&rarr;</div>
        <div class="modal-step"><span class="step-num">2</span> Link with Phone</div>
        <div class="modal-step-arrow">&rarr;</div>
        <div class="modal-step"><span class="step-num">3</span> Enter Code</div>
      </div>

      <!-- Phone Number Input Form -->
      <div id="phone-input-section" style="text-align: left; margin: 1rem 0;">
        <label for="pairing-phone-input" style="display: block; font-size: 0.85rem; font-weight: 600; color: #e2e8f0; margin-bottom: 0.5rem;">
          WhatsApp Phone Number
        </label>
        
        <div class="phone-input-row" style="display: flex; gap: 0.5rem; align-items: stretch;">
          <select 
            id="pairing-country-select" 
            class="form-control" 
            style="width: 145px; font-weight: 600; font-size: 0.88rem; cursor: pointer; background: rgba(15, 23, 42, 0.9); color: #fff; border-color: rgba(255, 255, 255, 0.15);"
            onchange="updatePhonePreview()"
          >
            <option value="91" selected>🇮🇳 +91 (India)</option>
            <option value="880">🇧🇩 +880 (BD)</option>
            <option value="92">🇵🇰 +92 (PK)</option>
            <option value="971">🇦🇪 +971 (UAE)</option>
            <option value="966">🇸🇦 +966 (KSA)</option>
            <option value="1">🇺🇸 +1 (US/CA)</option>
            <option value="44">🇬🇧 +44 (UK)</option>
            <option value="custom">🌐 Other</option>
          </select>

          <input 
            type="tel" 
            id="pairing-phone-input" 
            class="form-control" 
            placeholder="e.g. 8537096264" 
            style="flex: 1; font-size: 0.95rem; font-family: monospace; letter-spacing: 0.5px;"
            oninput="updatePhonePreview()"
          />

          <button 
            type="button" 
            class="btn btn-primary" 
            id="btn-get-pairing-code" 
            onclick="requestPairingCodeSubmit()"
            style="white-space: nowrap; padding: 0.65rem 1.15rem;"
          >
            <span id="btn-pairing-text">⚡ Get Code</span>
            <div id="btn-pairing-spinner" class="qr-spinner" style="display: none; width: 16px; height: 16px; margin: 0 auto; border-width: 2px;"></div>
          </button>
        </div>

        <div id="pairing-phone-preview" style="display: flex; align-items: center; justify-content: space-between; margin-top: 0.5rem; font-size: 0.78rem;">
          <span style="color: var(--text-muted);">
            International format: <strong id="preview-full-number" style="color: #34d399; font-family: monospace;">+91 (Enter number)</strong>
          </span>
          <span id="preview-country-name" style="color: #38bdf8; font-weight: 600;">India 🇮🇳</span>
        </div>
      </div>

      <!-- Pairing Code Result Display -->
      <div id="pairing-code-result" style="display: none; margin-top: 1.25rem;">
        <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); text-align: center; letter-spacing: 1px; margin-bottom: 0.35rem;">
          YOUR 8-DIGIT PAIRING CODE
        </div>

        <div class="pairing-code-badge" id="pairing-code-display">
          ----&nbsp;----
        </div>

        <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-top: 0.85rem; flex-wrap: wrap;">
          <button type="button" class="btn btn-secondary btn-sm" id="btn-copy-pairing-code" onclick="copyPairingCode()">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            <span id="copy-btn-text">Copy Code</span>
          </button>

          <button type="button" class="btn btn-secondary btn-sm" id="btn-refresh-pairing-code" onclick="requestPairingCodeSubmit()">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            <span>New Code</span>
          </button>

          <span class="qr-timer-pill" id="pairing-timer-pill" style="font-size: 0.78rem;">
            🟢 Waiting for mobile entry (<span id="pairing-countdown">120</span>s)
          </span>
        </div>

        <div style="background: rgba(15, 23, 42, 0.75); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 12px; padding: 0.85rem 1rem; margin-top: 1rem; font-size: 0.82rem; color: #cbd5e1; text-align: left; line-height: 1.6;">
          <strong style="color: #34d399; display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.35rem;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Follow these steps on your WhatsApp phone:
          </strong>
          <ol style="margin: 0.25rem 0 0 1.25rem; padding: 0;">
            <li>Open WhatsApp on <strong id="instruction-phone-num" style="color: #fff;">your phone</strong>.</li>
            <li>Tap <strong>Settings</strong> (or <strong>⋮</strong> menu) &gt; <strong>Linked Devices</strong>.</li>
            <li>Tap <strong>Link a Device</strong>.</li>
            <li>At the bottom of the QR camera screen, tap <strong>"Link with phone number instead"</strong>.</li>
            <li>Enter this 8-character code: <strong id="instruction-code" style="color: #10b981; font-family: monospace; letter-spacing: 1px;">---- ----</strong></li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Celebration Success View State (Appears upon pairing open) -->
    <div id="modal-success-view" style="display: none; padding: 1.5rem 0.5rem; text-align: center;">
      <div class="success-checkmark-circle">
        <svg width="44" height="44" fill="none" stroke="#10b981" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h3 style="font-size: 1.4rem; font-weight: 700; color: #fff;">Connected Successfully!</h3>
      <p style="font-size: 0.95rem; color: var(--text-accent); font-weight: 600; margin-top: 0.35rem;" id="modal-success-phone"></p>
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem;">This account is now officially saved and ready to send messages.</p>
    </div>

    <div class="qr-modal-footer">
      <button type="button" class="btn btn-secondary btn-sm" onclick="closePairingModal()">Cancel</button>
    </div>
  </div>
</div>

<!-- Connect Page Client Script -->
<script>
  window.currentSlot = <%= selectedSlot %>;
  window.currentSessionId = '<%= selectedSessionId %>';
  window.maxAccounts = <%= maxAccounts %>;
</script>
<script src="/js/connect.js" defer></script>
